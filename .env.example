# Groq API Configuration
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Default Answering Models (Student models to evaluate)
# Options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it, deepseek-r1-distill-llama-70b
GROQ_MODEL=llama-3.3-70b-versatile

# Default Judge Model (Teacher model)
GROQ_JUDGE_MODEL=llama-3.3-70b-versatile
